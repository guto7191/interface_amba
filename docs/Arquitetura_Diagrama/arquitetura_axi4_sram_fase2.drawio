          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_p_SRAM_UB_N" value="SRAM_UB_N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#006F91;strokeWidth=2;fontColor=#004F68;exitX=1;exitY=0.7303;entryX=0;entryY=0.7303;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_iob" target="p2_sram">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_p_SRAM_CE_N" value="SRAM_CE_N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#006F91;strokeWidth=2;fontColor=#004F68;exitX=1;exitY=0.8553;entryX=0;entryY=0.8553;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_iob" target="p2_sram">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_fifo" value="&lt;b&gt;FIFO de requisições do axi_transaction_manager — 11 bits (A5, MAS §5.4.2)&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;margin-top:6px;font-size:10px&quot;&gt;&lt;tr style=&quot;background:#E6E8E9&quot;&gt;&lt;td&gt;&lt;b&gt;bit 10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;bit 9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;bits 8:5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#FFD9A8&quot;&gt;&lt;b&gt;bits 4:3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#FFD9A8&quot;&gt;&lt;b&gt;bits 2:0&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;é_leitura&lt;/td&gt;&lt;td&gt;é_último&lt;/td&gt;&lt;td&gt;id&lt;/td&gt;&lt;td style=&quot;background:#FFD9A8&quot;&gt;addr[1:0] (novo)&lt;/td&gt;&lt;td style=&quot;background:#FFD9A8&quot;&gt;size (novo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R ou B&lt;/td&gt;&lt;td&gt;rlast / bvalid&lt;/td&gt;&lt;td&gt;rid / bid&lt;/td&gt;&lt;td&gt;→ resp_addr_lo_o&lt;/td&gt;&lt;td&gt;→ resp_size_o&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;Profundidade 4 → máx. 4 transações em voo (R-13). A ordem estrita do FIFO cumpre R-03." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9AA0A4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="620" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p2_rules" value="&lt;b&gt;Regras normativas do contrato ram_* (MAS §3.2)&lt;/b&gt;&lt;ol style=&quot;margin:4px 0 0 0;padding-left:18px&quot;&gt;&lt;li&gt;Requisição: ram_wr_req=1 ou ram_rd=1; consumida quando ram_accept=1. ram_wr=0000 → ack sem acesso (D16)&lt;/li&gt;&lt;li&gt;Estabilidade: entradas estáveis até ram_accept&lt;/li&gt;&lt;li&gt;Exclusividade: ram_wr_req e ram_rd nunca juntos&lt;/li&gt;&lt;li&gt;Resposta: ram_ack por exatamente 1 ciclo por requisição aceita&lt;/li&gt;&lt;li&gt;Ordenação: respostas na ordem das requisições (base de R-03)&lt;/li&gt;&lt;li&gt;Pipeline: até 2 requisições em voo na Fase 2 (1 na Fase 1)&lt;/li&gt;&lt;li&gt;Latência: sem máximo, mas ram_accept nunca negado indefinidamente&lt;/li&gt;&lt;li&gt;Contexto: addr[1:0] e size voltam pela FIFO, não por caminho paralelo&lt;/li&gt;&lt;/ol&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9AA0A4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="700" y="1080" width="640" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="p2_foot" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• ram_size chega ao sram_controller mas não é usado: a leitura é sempre de 32 bits (comentário em sram_controller.v).&lt;br&gt;• ram_len_o e ram_error_i existem no fork mas não fazem parte do contrato; ram_error_i = 1'b0.&lt;br&gt;• aclk = CLOCK_50 e aresetn (de reset_synchronizer) chegam a todos os blocos; o fork recebe rst_i = ~aresetn." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1080" width="440" height="120" as="geometry"/>
        </mxCell>
